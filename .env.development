# Modo sesion: la aplicacion sale de GET /api/v1/me/applications del componente de seguridad.
# Requiere el backend con docker-compose.security-session.yml (perfil security-session).
VITE_SESSION_WORKSPACE=true
# Organizacion de negocio donde se registran las aplicaciones de seguridad (seed UCO).
VITE_DEFAULT_ORGANIZATION_ID=8f2d3a10-6b47-4c91-a5e8-2d7f9b3c1a40

# Destino fijo anterior; solo aplica si VITE_SESSION_WORKSPACE no es true.
VITE_LOCAL_WORKSPACE=true
